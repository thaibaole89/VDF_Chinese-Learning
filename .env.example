# --- Pilot access gate (Phase 1H) ---
# If set, all main app routes require the user to enter this password before
# seeing app content. The cookie that grants access is httpOnly and lasts 7 days.
# If UNSET, the gate is disabled and the app is publicly viewable.
#
# Configure on Vercel:
#   Vercel Project → Settings → Environment Variables → add
#   PILOT_ACCESS_PASSWORD → select Production + Preview → Save → Redeploy
#
# ROTATE by changing the value and redeploying. Existing cookies expire after
# 7 days; users will need to log in again.
#
# WARNING: do NOT prefix with NEXT_PUBLIC_ — that would expose the password to
# the client bundle.
PILOT_ACCESS_PASSWORD=change-me-for-internal-pilot
