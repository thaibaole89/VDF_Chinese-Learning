# --- Pilot access gate (Phase 1H) ---
# If set, all main app routes require the user to enter this password before
# seeing app content. The cookie that grants access is httpOnly and lasts 7 days.
# If UNSET, the gate is disabled and the app is publicly viewable.
#
# Configure on Vercel:
#   Vercel Project → Settings → Environment Variables → add
#   PILOT_ACCESS_PASSWORD → select Production + Preview → Save → Redeploy
#
# ROTATE by changing the value and redeploying. Existing cookies expire after
# 7 days; users will need to log in again.
#
# Phase 2A go-live: REMOVE this once Supabase Auth is the source of truth (see PHASE_2A_SETUP.md).
#
# WARNING: do NOT prefix with NEXT_PUBLIC_ — that would expose the password to
# the client bundle.
PILOT_ACCESS_PASSWORD=change-me-for-internal-pilot

# --- Supabase Auth + DB (Phase 2A) ---
# Both vars REQUIRED for auth + server progress. If UNSET, the auth gate is a
# no-op (app runs anonymously in local-only mode) — useful for early dev.
# Get values from: Supabase Dashboard → Project Settings → API.
#   - URL is the project URL (https://<project-ref>.supabase.co)
#   - ANON KEY is the "anon" / "public" JWT (role=anon) — SAFE in client bundle
# Do NOT paste the service_role / secret key here — it MUST NEVER reach the client.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_JWT
